## Configuring the frontend rendering
plugin.tx_srfreecap {
	settings {
		imageHeight = {$plugin.tx_srfreecap.imageHeight ?? $freecap.imageHeight}
		imageAdditionalWidth = {$plugin.tx_srfreecap.imageAdditionalWidth ?? $freecap.imageAdditionalWidth}
		imageFormat = {$plugin.tx_srfreecap.imageFormat ?? $freecap.imageFormat}

		textHorizontalPosition = {$plugin.tx_srfreecap.textHorizontalPosition ?? $freecap.textHorizontalPosition}
		textVerticalPosition = {$plugin.tx_srfreecap.textVerticalPosition ?? $freecap.textVerticalPosition}

		backgroundType = {$plugin.tx_srfreecap.backgroundType ?? $freecap.backgroundType}
		backgroundBlur = {$plugin.tx_srfreecap.backgroundBlur ?? $freecap.backgroundBlur}
		backgroundMorph = {$plugin.tx_srfreecap.backgroundMorph ?? $freecap.backgroundMorph}

		maxWordLength = {$plugin.tx_srfreecap.maxWordLength ?? $freecap.maxWordLength}
		useWordsList = {$plugin.tx_srfreecap.useWordsList ?? $freecap.useWordsList}
		generateNumbers = {$plugin.tx_srfreecap.generateNumbers ?? $freecap.generateNumbers}

		colorMaximumDarkness = {$plugin.tx_srfreecap.colorMaximumDarkness ?? $freecap.colorMaximumDarkness}
		colorMaximumLightness = {$plugin.tx_srfreecap.colorMaximumLightness ?? $freecap.colorMaximumLightness}
		textColor = {$plugin.tx_srfreecap.textColor ?? $freecap.textColor}
		mergeWithBackground = {$plugin.tx_srfreecap.mergeWithBackground ?? $freecap.mergeWithBackground}
		morphFactor = {$plugin.tx_srfreecap.morphFactor ?? $freecap.morphFactor}
		defaultWordsList = {$plugin.tx_srfreecap.defaultWordsList ?? $freecap.defaultWordsList}
		fontFiles = {$plugin.tx_srfreecap.fontFiles ?? $freecap.fontFiles}

		maxAttempts = {$plugin.tx_srfreecap.maxAttempts ?? $freecap.maxAttempts}

		accessibleOutput = {$plugin.tx_srfreecap.accessibleOutput ?? $freecap.accessibleOutput}
		accessibleOutputImage = {$plugin.tx_srfreecap.accessibleOutputImage ?? $freecap.accessibleOutputImage}
		
		salutation = {$plugin.tx_srfreecap.salutation ?? $freecap.salutation}
	}
	view {
		partialRootPaths {
			0 = EXT:sr_freecap/Resources/Private/Partials/
			1 = {$plugin.tx_srfreecap.view.partialRootPath ?? $freecap.view.partialRootPath}
		}
	}
	_CSS_DEFAULT_STYLE (
		.tx-srfreecap-captcha label { display: inline-block; width: 150px; }
		img.tx-srfreecap-image { margin-left: 1em; margin-right: 1em; vertical-align: middle; }
		.tx-srfreecap-image-accessible {
			background-color: transparent;
			vertical-align: middle;
		}
		.tx-srfreecap-accessible-link { width: 10em; float: right; vertical-align: middle; margin-right: 7em; }
		.tx-srfreecap-cant-read { display: inline-block; width: 150px; }
		.tx-srfreecap-cant-read a:link { background-color:transparent; font-weight:bold; text-decoration:none; }
	)
}

## Backward pi_base compatibility
plugin.tx_srfreecap_pi2 {
	_CSS_DEFAULT_STYLE (
		.tx-srfreecap-pi1-captcha label { display: inline-block; width: 150px; }
		img.tx-srfreecap-pi1-image { margin-left: 1em; margin-right: 1em; vertical-align: middle; }
		.tx-srfreecap-pi1-image-accessible {
			background-color: transparent;
			vertical-align: middle;
		}
		.tx-srfreecap-pi1-accessible-link { width: 10em; float: right; vertical-align: middle; margin-right: 7em; }
		.tx-srfreecap-pi1-cant-read { display: inline-block; width: 150px; }
		.tx-srfreecap-pi1-cant-read a:link { background-color:transparent; font-weight:bold; text-decoration:none; }
	)
}
## Include required js (this is required as the captcha might be included in the reponse of an ajax call)
page.includeJSFooterlibs.sr-freecap = EXT:sr_freecap/Resources/Public/JavaScript/freeCap.js